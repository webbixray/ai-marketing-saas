# Laravel Application
APP_NAME=AI Marketing SaaS
APP_ENV=production
APP_KEY=[REDACTED]
APP_DEBUG=false
APP_URL=https://ai-marketing-saas.com

# Database
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ai_marketing_saas
DB_USERNAME=[REDACTED]
DB_PASSWORD=[REDACTED]

# Redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_DRIVER=redis
REDIS_HOST=localhost
REDIS_PASSWORD=[REDACTED]
REDIS_PORT=6379

# Multi-Tenant
TENANT_MODE=database
TENANT_SCOPE_MODEL=App\\Models\\Tenant

# Authentication
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_EXPIRATION=2629800

# Billing (Cashier)
STRIPE_KEY=[REDACTED]
STRIPE_SECRET=[REDACTED]
STRIPE_WEBHOOK_KEY=[REDACTED]

# AI Services
OPENAI_API_KEY=[REDACTED]
ANTHROPIC_API_KEY=[REDACTED]
LLM_MODEL=gpt-4o-mini

# Feature Flags
FEATURE_FLAG_BILLING_ENABLED=true
FEATURE_FLAG_AI_CONTENT_ENABLED=true
FEATURE_FLAG_ATTRACTION_ENABLED=true
FEATURE_FLAG_AUDIENCE_ENABLED=true

# Monitoring
PULSE_ENABLED=true
LOG_CHANNEL=stack
LOG_LEVEL=info
